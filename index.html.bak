<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Valentine's Week of Love</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Roboto:wght@300;400;500&display=swap" rel="stylesheet">
    <!-- AOS CSS for animations -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="styles.css">
</head>
<body>
    <div class="landing-page">
        <h1 data-aos="fade-down">Valentine's Week of Love</h1>
        <p class="subtitle" data-aos="fade-up">A journey through eight days of romance and celebration</p>
        
        <div class="days-grid">
            <a href="pages/day1.html" class="day-card" data-aos="fade-up" data-aos-delay="100">
                <h2>Rose Day</h2>
                <p>Express your love with roses</p>
                <span class="date">Feb 7</span>
            </a>
            
            <a href="pages/day2.html" class="day-card" data-aos="fade-up" data-aos-delay="200">
                <h2>Propose Day</h2>
                <p>The day to express your feelings</p>
                <span class="date">Feb 8</span>
            </a>
            
            <a href="pages/day3.html" class="day-card" data-aos="fade-up" data-aos-delay="300">
                <h2>Chocolate Day</h2>
                <p>Sweet moments together</p>
                <span class="date">Feb 9</span>
            </a>
            
            <a href="pages/day4.html" class="day-card" data-aos="fade-up" data-aos-delay="400">
                <h2>Teddy Day</h2>
                <p>Cuddles and affection</p>
                <span class="date">Feb 10</span>
            </a>
            
            <a href="pages/day5.html" class="day-card" data-aos="fade-up" data-aos-delay="500">
                <h2>Promise Day</h2>
                <p>Promises from the heart</p>
                <span class="date">Feb 11</span>
            </a>
            
            <a href="pages/day6.html" class="day-card" data-aos="fade-up" data-aos-delay="600">
                <h2>Hug Day</h2>
                <p>Embrace the love</p>
                <span class="date">Feb 12</span>
            </a>
            
            <a href="pages/day7.html" class="day-card" data-aos="fade-up" data-aos-delay="700">
                <h2>Kiss Day</h2>
                <p>Sealed with a kiss</p>
                <span class="date">Feb 13</span>
            </a>

            <a href="pages/day8.html" class="day-card special" data-aos="fade-up" data-aos-delay="800">
                <h2>Valentine's Day</h2>
                <p>The grand celebration of our love</p>
                <span class="date">Feb 14</span>
            </a>

            <a href="pages/anniversary.html" class="day-card anniversary-card" data-aos="fade-up" data-aos-delay="900">
                <h2>Anniversary Day</h2>
                <p>Celebrating a lifetime of love</p>
                <span class="date">Special Day</span>
            </a>
        </div>
    </div>

    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init({
            duration: 800,
            once: true
        });
    </script>
</body>
</html> 